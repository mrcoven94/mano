# Mano accounts: every variable by name, never a value.
# WorkOS AuthKit for web sign-in. David creates a separate WorkOS environment for Mano.
MANO_WORKOS_API_KEY=
MANO_WORKOS_CLIENT_ID=
# Where AuthKit redirects after sign-in, for example https://withmano.com/api/auth/callback
MANO_WORKOS_REDIRECT_URI=
# Signs engine session exchange and code hashes. 32+ random bytes, base64.
MANO_ACCOUNTS_PEPPER=
# Encrypts stored identity values. 32 bytes, base64.
MANO_ACCOUNTS_KEK_B64=
# Engine base URL for session exchange, for example https://engine.example.org
MANO_ENGINE_BASE_URL=
# Channels Worker service binding name for sending phone codes. Set in wrangler config.
MANO_CHANNELS_BINDING=
