# Mano accounts: every variable by name, never a value.
# src/config.ts decides the mode from these. Live needs all four of the engine
# and Channels names. A production start without them fails unless demo mode is on.
# Engine Worker base URL for the accounts routes.
MANO_ENGINE_URL=
# Server-to-server credential for the engine accounts routes.
MANO_ENGINE_SERVICE_KEY=
# Channels Worker base URL for the route that sends phone codes.
MANO_CHANNELS_URL=
# Credential for the Channels code route.
MANO_CHANNELS_KEY=
# Set to 1 for demo mode on stand-ins, which the sign-in and account pages label.
MANO_ACCOUNTS_DEMO=
# config.ts also reads NODE_ENV, which the runtime sets: when it is not
# "production", missing names mean stand-ins.

# WorkOS AuthKit for email sign-in (src/workos.ts). Without all three, email
# sign-in answers 503.
MANO_WORKOS_API_KEY=
MANO_WORKOS_CLIENT_ID=
# Where AuthKit redirects after sign-in, for example https://withmano.com/api/auth/callback
MANO_WORKOS_REDIRECT_URI=

# The package takes these two by value. The app that hosts it reads them from
# its own environment and passes them in.
# Keys the lookup hashes and code hashes and signs the OAuth cookie. 32 or more
# random bytes, base64.
MANO_ACCOUNTS_PEPPER=
# Encrypts stored identity values. 32 bytes, base64.
MANO_ACCOUNTS_KEK_B64=
