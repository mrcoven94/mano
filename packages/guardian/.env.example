# Copy to .env and fill in. Never commit values.
# Base URL of the guardian model endpoint (OpenAI-compatible). Empty means rules only.
MANO_GUARDIAN_URL=
# Bearer token for the guardian endpoint. Stored in Infisical under this name.
MANO_GUARDIAN_TOKEN=
# Model ID served behind MANO_GUARDIAN_URL. Must match the deployed checkpoint.
MANO_GUARDIAN_MODEL=RedHatAI/Muse-Glimmer-30B-FP8-block
