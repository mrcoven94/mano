# Copy to .env and fill in. Never commit values.
# Explicit local rules-only mode. Set to 1 to check without any endpoint.
MANO_GUARDIAN_RULES_ONLY=
# Base URL of the guardian endpoint. Half configured (URL without a token)
# blocks everything instead of silently dropping to rules-only.
MANO_GUARDIAN_URL=
# Bearer token checked inside the endpoint container.
MANO_GUARDIAN_TOKEN=
# Proxy pair checked at Modal's proxy before any container wakes.
MANO_GUARDIAN_KEY_ID=
MANO_GUARDIAN_KEY_SECRET=
# Served model record, printed with eval results. Must match the deploy.
MANO_GUARDIAN_MODEL=RedHatAI/Muse-Glimmer-30B-FP8-block@1deb4641ff84f9a728dd11b27cac1f6a02a9ed14
