# Names only, never values. Copy to .env to run the computer against live services.
# Meta model key (Infisical: META_MODEL_API_KEY). All model calls go through the gateway below.
META_MODEL_API_KEY=
# Responses API base URL, through Cloudflare AI Gateway.
MODEL_BASE_URL=
# Model ID for computer use. Standard IDs only with resident content; -contributor IDs only for synthetic runs.
MODEL_NAME=muse-spark-1.3
# Which computer to drive: playwright (local stand-in) or modal (hosted desktop).
COMPUTER_BACKEND=playwright
# Modal session service base URL (from `modal deploy` in modal/). Needed only for COMPUTER_BACKEND=modal.
MODAL_COMPUTER_URL=
# The session service's bearer token, the same value as MANO_COMPUTER_TOKEN in the mano-computer Modal secret.
MODAL_COMPUTER_TOKEN=
# Engine's id for the person. The service turns it into that person's own profile volume. Required for modal.
COMPUTER_PERSON_ID=
# Persistent profile directory for the playwright stand-in. Defaults to a temp dir.
COMPUTER_PROFILE_DIR=
# The service itself reads three keys from the mano-computer Modal secret (set in the Modal dashboard):
# MANO_COMPUTER_TOKEN (session bearer token), MANO_PROFILE_KEY (HMAC key for profile volume names),
# MANO_PORTAL_ORIGIN (the one https origin desktops may open, for example the sandbox portal).
