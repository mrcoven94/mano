# Names only, never values. Copy to .env and fill in what the run you want needs.
# The package's own code reads the first five; the live probes in probe/ read the rest.

# Which computer to drive: playwright (local Chromium, the default) or modal (hosted desktop).
COMPUTER_BACKEND=
# Session service base URL, from `modal deploy` in modal/. Required for COMPUTER_BACKEND=modal.
MODAL_COMPUTER_URL=
# The session service's bearer token, the same value as MANO_COMPUTER_TOKEN in the mano-computer Modal secret.
MODAL_COMPUTER_TOKEN=
# Engine's id for the person. The service turns it into that person's own profile volume. Required for COMPUTER_BACKEND=modal.
COMPUTER_PERSON_ID=
# Persistent profile directory for local Chromium. Without it each run starts a fresh browser.
COMPUTER_PROFILE_DIR=

# OpenRouter key. The probes use it to run Meta's open-weight model, pinned to zero retention.
OPENROUTER_API_KEY=
# A Modal Shared Endpoint's URL. With it, the open-weight probes run on Modal and not on OpenRouter.
MODAL_ENDPOINT_URL=
# The proxy token for that Modal endpoint. Required with MODAL_ENDPOINT_URL.
MODAL_PROXY_TOKEN=
# Meta model key. The layouts probe needs it for MEASURE_MODEL=meta, and for route when route runs Muse Spark 1.3.
META_MODEL_API_KEY=
# Another base URL for the Meta Model API in the layouts probe. Defaults to Meta's own.
MANO_MODEL_BASE_URL=
# The agent's route switch. The layouts probe reads it only for MEASURE_MODEL=route (see probe/layouts.probe.ts).
MANO_MODEL_PROVIDER=

# The layouts probe (probe/layouts.probe.ts). It is skipped without MEASURE_PORTAL_URL.
# Base URL of a sandbox portal you started.
MEASURE_PORTAL_URL=
# That portal's draft token, used to read back what a fill saved.
SANDBOX_PORTAL_DRAFT_TOKEN=
# Which model fills: standin (the default, no model and no credit), meta, open or route.
MEASURE_MODEL=
# Which limits to run under: agent, probe or both (the default).
MEASURE_LIMITS=
# How many seeded layouts to run, 0 to 5. Defaults to 5.
MEASURE_SCRAMBLES=
# Comma separated seeds to rerun. Defaults to new seeds each run.
MEASURE_SEEDS=
# Set to 0 to leave out the fixed layouts.
MEASURE_FIXED=
# A folder for results.json and each layout's last screen.
MEASURE_OUT=
# Set to 1 so the stand-in types two values into each other's fields, to show the read-back catches a miss.
MEASURE_STANDIN_SWAP=

# The service itself reads three keys from the mano-computer Modal secret (set in the Modal dashboard):
# MANO_COMPUTER_TOKEN (session bearer token), MANO_PROFILE_KEY (HMAC key for profile volume names),
# MANO_PORTAL_ORIGIN (the one https origin desktops may open, for example the sandbox portal).
