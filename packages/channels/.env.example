# Names only, never values. Used by the live persona probes
# (pnpm --filter @mano/channels probe:live); unit tests need none.
META_MODEL_API_KEY=
# Optional. Defaults to https://api.meta.ai/v1.
MANO_MODEL_BASE_URL=
# Optional. Probes send synthetic text only, so this must be a
# -contributor model ID. Defaults to muse-spark-1.3-contributor.
MANO_PROBE_MODEL=
