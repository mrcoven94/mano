# Copy to .env for live runs. Never commit values.
# Names only. Every name packages/mail/src/model.ts reads is listed here.

# Meta Model API key. With no route chosen below, Mail reads on Meta's API.
META_MODEL_API_KEY=

# Which route reads a letter: "modal" or "openrouter". Unset means Meta's API.
MANO_MODEL_PROVIDER=
# The Modal route: a Shared Endpoint URL on *.modal.direct and its proxy token.
MODAL_ENDPOINT_URL=
MODAL_PROXY_TOKEN=
# The OpenRouter route, and the backup for the Modal route when both are set.
OPENROUTER_API_KEY=

# Optional, Meta route only: go through Cloudflare AI Gateway instead of direct.
CF_ACCOUNT_ID=
AI_GATEWAY_ID=
AI_GATEWAY_PROVIDER=
# Optional, Meta route only: extra model IDs the client may send, comma separated.
MODEL_ALLOWLIST_EXTRA=
