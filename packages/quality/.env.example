# @mano/quality reads only these variables. Names, never values. Without keys it runs
# on stand-ins (fake model client, local link verdicts, in-memory stores) and says so.

# Model calls (Meta key from Infisical in production; GitHub secret in Actions).
META_MODEL_API_KEY=
# Base URL of the model endpoint. The client posts an OpenAI-style chat request.
# Optional: it defaults to https://api.meta.ai/v1 when unset.
MANO_MODEL_BASE_URL=
# Model IDs. Standard IDs only for anything touching real content, including
# live in-place judging. A contributor ID is for synthetic bench data only, and
# only as MANO_MODEL_BENCH_ID, the model that answers the bench cases. The judge
# always runs on a Standard ID: the code throws when MANO_MODEL_JUDGE_ID ends
# in -contributor, and it refuses a judge ID equal to the bench ID.
MANO_MODEL_JUDGE_ID=
MANO_MODEL_BENCH_ID=
# Optional judge for the agent stage: a Standard model ID other than the
# agent's. A -contributor ID throws. Unset, the stage uses the bench judge.
MANO_MODEL_AGENT_JUDGE_ID=
# The Standard model ID for the crisis check on one short health question,
# as the worker uses (defaults to the Standard reply model).
MANO_MODEL_CRISIS_CHECK_ID=

# Link checks. Live DNS uses DNS-over-HTTPS; unset means local fixture verdicts.
MANO_QUALITY_LIVE_DNS=
MANO_QUALITY_DNS_URL=
MANO_QUALITY_DNS_FAMILY_URL=

# Safety holdout: file outside the repo, written by the architect. The run
# verifies its SHA-256 against the committed pin before using it.
MANO_QUALITY_HOLDOUT_PATH=
MANO_QUALITY_HOLDOUT_SHA256=

# Cost math for the report, USD per 1,000 tokens.
QUALITY_PRICE_INPUT_PER_1K=
QUALITY_PRICE_OUTPUT_PER_1K=

# Live alerts post numbers only to LAP-567 through the Linear API.
LINEAR_BACKPACK_API_KEY=
LINEAR_API_URL=

# Nightly runs land in R2: aggregates in the bucket mano-quality, per-case data
# in mano-quality-private. The nightly upload, the baseline restore, the smoke's
# read of main's baseline and the staff page sign their requests with these.
# Access key pair for the two buckets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The account that owns the buckets. Set this or R2_ENDPOINT.
R2_ACCOUNT_ID=
# The account's R2 address; its first host label is used as the account.
R2_ENDPOINT=

# Set to 1 in CI: anything that keeps the smoke or nightly comparison from
# completing fails the gate. Unset, an incomplete comparison is neutral.
QUALITY_GATE_STRICT=
# Set to 1 to answer every case with a stand-in that breaks each gate on
# purpose (an invented phone and link, a promise of approval, an outside
# action), to show that the gates fail when they should. The bench's --broken
# flag does the same.
MANO_QUALITY_BROKEN=

# A running agent to score the text cases through. Needs MANO_AGENT_SECRET and
# MANO_HANDLE_GRANT_SECRET (below), META_MODEL_API_KEY and MANO_MODEL_BENCH_ID.
# The --agent-local flag starts its own agent and sets this itself.
QUALITY_AGENT_URL=

# The smoke workflow sets these so smoke-publish can post its result on the
# pull request: a GitHub token, the pull request number and its head commit.
GH_TOKEN=
PR_NUMBER=
HEAD_SHA=
# Also read, and set by GitHub Actions or the shell, never by hand:
# GITHUB_REPOSITORY, GITHUB_ACTOR, GITHUB_RUN_ID and GITHUB_STEP_SUMMARY, plus
# PATH, HOME and CI, which the local agent stack passes to the servers it starts.
# FAKE_PID_FILE is passed the same way and is set only by this package's tests.

# pnpm spine:live: the deployment to drive, from the first text to the portal's
# confirmation number. It spends model credit and files on the sandbox portal.
MANO_AGENT_URL=
MANO_ENGINE_URL=
MANO_PORTAL_URL=
MANO_AGENT_SECRET=
MANO_HANDLE_GRANT_SECRET=
MANO_ENGINE_CHANNELS_TOKEN=
MANO_ENGINE_AGENT_TOKEN=
SANDBOX_PORTAL_TOKEN=
MANO_GUARDIAN_URL=
MANO_GUARDIAN_TOKEN=
MANO_GUARDIAN_KEY_ID=
MANO_GUARDIAN_KEY_SECRET=
