# @mano/quality reads only these variables. Names, never values. Without keys it runs
# on stand-ins (fake model client, local link verdicts, in-memory stores) and says so.

# Model calls (Meta key from Infisical in production; GitHub secret in Actions).
META_MODEL_API_KEY=
# Base URL of the model endpoint. The client posts an OpenAI-style chat request.
MANO_MODEL_BASE_URL=
# Model IDs. Standard IDs only for anything touching real content, including
# live in-place judging. The contributor ID is for synthetic bench data only:
# CI sets MANO_MODEL_JUDGE_ID to the contributor ID for smoke and nightly runs.
MANO_MODEL_JUDGE_ID=
MANO_MODEL_BENCH_ID=

# Link checks. Live DNS uses DNS-over-HTTPS; unset means local fixture verdicts.
MANO_QUALITY_LIVE_DNS=
MANO_QUALITY_DNS_URL=
MANO_QUALITY_DNS_FAMILY_URL=

# Safety holdout: file outside the repo, written by the architect. The run
# verifies its SHA-256 against the committed pin before using it.
MANO_QUALITY_HOLDOUT_PATH=
MANO_QUALITY_HOLDOUT_SHA256=

# Cost math for the report, USD per 1,000 tokens.
QUALITY_PRICE_INPUT_PER_1K=
QUALITY_PRICE_OUTPUT_PER_1K=

# Live alerts post numbers only to LAP-567 through the Linear API.
LINEAR_BACKPACK_API_KEY=
LINEAR_API_URL=

# Nightly runs land in R2 (bucket mano-quality, one folder per run). The staff
# page reads them from this public base URL.
QUALITY_RUNS_URL=
QUALITY_STAFF_TOKEN=
