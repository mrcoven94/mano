# Engine local config. Copy to .dev.vars (never commit it) and fill in
# values from Infisical with `ws keys`. Names only here, never values.
#
# Required for live model calls and documents:
META_MODEL_API_KEY= # gitleaks:allow (empty example value)
ENCRYPTION_KEK_B64= # gitleaks:allow (empty example value)
SESSION_SECRET= # gitleaks:allow (empty example value)
OPERATOR_SECRET= # gitleaks:allow (empty example value)
# The agent's service credential: its token, and the secret Channels
# signs handle grants with. Both unset means the agent path is closed.
MANO_ENGINE_AGENT_TOKEN= # gitleaks:allow (empty example value)
MANO_HANDLE_GRANT_SECRET= # gitleaks:allow (empty example value)
# Channels' token for deleting a conversation's state here.
MANO_ENGINE_CHANNELS_TOKEN= # gitleaks:allow (empty example value)
# Due reminders go through Channels' agent-send route, signed with the
# Engine-to-Channels secret, which Channels holds too (never the agent).
MANO_CHANNELS_URL=
MANO_ENGINE_SEND_SECRET= # gitleaks:allow (empty example value)
# Local time deadline nudges go out, HH:MM between 09:00 and 20:00
# (default 10:00).
MANO_NUDGE_TIME=
# The judge demo (src/try): the agent's URL and the secret its turn route checks.
# Without both it stays off. MANO_TRY=off in wrangler.toml stops it.
MANO_AGENT_URL=
MANO_AGENT_SECRET= # gitleaks:allow (empty example value)
# "on" lets the daily check for new help send its text. wrangler.toml ships off.
MANO_DAILY_CHECK_SENDS=
# Environment name. development allows the dev session secret and the
# simulated executor and stand-in model without explicit choice.
MANO_ENV=development
# Model routing: with account and gateway IDs, calls go through
# Cloudflare AI Gateway; without them, direct to the model API.
CF_ACCOUNT_ID=
AI_GATEWAY_ID=
AI_GATEWAY_PROVIDER=
# Extra allowlisted model IDs, comma separated (rarely needed):
MODEL_ALLOWLIST_EXTRA=
# Executor: simulated (default) or sandbox. Sandbox mode needs the
# sandbox agency portal's URL and its access token (SANDBOX_PORTAL_TOKEN
# on the portal Worker):
EXECUTOR_MODE=
SANDBOX_BASE_URL=
SANDBOX_PORTAL_TOKEN=
# Faxes and mailed letters stay off until their settings are present. Mail
# reads only a test mode key and refuses anything else. A fax goes only to
# MANO_OWN_FAX_NUMBER. The webhook secret and public key open
# /webhooks/mail and /webhooks/fax. The cents settings override the prices
# the approval question shows.
LOB_TEST_API_KEY= # gitleaks:allow (empty example value)
LOB_WEBHOOK_SECRET= # gitleaks:allow (empty example value)
TELNYX_API_KEY= # gitleaks:allow (empty example value)
TELNYX_FAX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
MANO_OWN_FAX_NUMBER=
MANO_FAX_FROM_NUMBER=
MANO_FAX_CENTS_PER_PAGE=
MANO_MAIL_BASE_CENTS=
MANO_MAIL_CENTS_PER_EXTRA_PAGE=
# Guardian checks every action after the local rules when its URL is set;
# with none of these four set the checker is local rules only, and a
# partial set blocks every action. The key pair is Modal's
# proxy auth, needed for the hosted endpoint and not for the local
# stand-in (packages/guardian/standin/server.mjs).
MANO_GUARDIAN_URL=
MANO_GUARDIAN_TOKEN= # gitleaks:allow (empty example value)
MANO_GUARDIAN_KEY_ID=
MANO_GUARDIAN_KEY_SECRET= # gitleaks:allow (empty example value)
# Hold calls: stay off until a phone provider is set up in
# src/calls/provider.ts. Our own numbers Mano may dial, comma separated in
# E.164; the one person ID who may use it and the one phone it rings; and
# the limits (defaults 60 minutes on hold, 45 seconds ringing).
MANO_CALL_ALLOWED_NUMBERS=
MANO_CALL_PERSON_ID=
MANO_CALL_PERSON_NUMBER=
MANO_CALL_HOLD_LIMIT_MINUTES=
MANO_CALL_RING_LIMIT_SECONDS=
