# Names only; values come from the Vercel project environment (production)
# or Infisical via `ws keys run` (local dev). Never commit values.
# Meta Model API key. The only model credential the agent needs.
META_MODEL_API_KEY=
# Shared secret signing both directions of Channels traffic.
MANO_AGENT_SECRET=
# Channels worker base URL, for reminder and nudge delivery.
MANO_CHANNELS_URL=
# Sandbox portal base URL, for form drafts.
MANO_PORTAL_URL=
# IANA timezone for day-relative reminder times. Default America/Denver.
MANO_TIMEZONE=
# Vercel KV (Redis) for durable reminders. When unset, reminders live in
# process memory: fine for local dev, lost on restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=
