# Names only; values come from the Vercel project environment (production)
# or the maintainer's key vault at run time (local dev). Never commit values.
# Meta Model API key. The only model credential the agent needs.
META_MODEL_API_KEY=
# Shared secret signing agent traffic with Channels, both ways.
MANO_AGENT_SECRET=
# Engine base URL and the agent's own Engine token. Each turn also
# carries a handle grant from Channels; the agent never signs grants.
# Engine holds the agent's per-person state, so no other store is needed.
ENGINE_URL=
MANO_ENGINE_AGENT_TOKEN=
# Guardian endpoint, warmed when a conversation starts (optional; see
# packages/guardian/.env.example). Without a URL nothing is warmed.
MANO_GUARDIAN_URL=
MANO_GUARDIAN_TOKEN=
MANO_GUARDIAN_KEY_ID=
MANO_GUARDIAN_KEY_SECRET=
# IANA timezone for day-relative reminder times. Default America/Denver.
MANO_TIMEZONE=
# Filling out forms (fill_form). The sandbox portal's base URL; forms are
# filled only there. Without it, fill_form says forms are not set up.
MANO_PORTAL_URL=
# The portal's read-only draft token (the portal's SANDBOX_PORTAL_DRAFT_TOKEN).
# fill_form reads each filled draft back with it and holds exactly what the
# portal saved. It cannot file. Without it, fill_form says it is unavailable.
SANDBOX_PORTAL_DRAFT_TOKEN=
# The person's computer: the Modal desktop service URL and its token
# (packages/computer). Without a URL, fill_form says the computer is not
# available. COMPUTER_BACKEND=playwright uses local Chromium instead. The
# desktop is opened for the person's Engine id on each call, not from env.
MODAL_COMPUTER_URL=
MODAL_COMPUTER_TOKEN=
COMPUTER_BACKEND=
# Computer-use model ID. Default muse-spark-1.3; -contributor IDs only for
# synthetic runs.
MANO_COMPUTER_MODEL=
# Longest a fill may take inside a turn, in milliseconds. Default 60000.
MANO_FILL_DEADLINE_MS=
