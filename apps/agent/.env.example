# Names only; values come from the Vercel project environment (production)
# or the maintainer's key vault at run time (local dev). Never commit values.
# Meta Model API key. The only model credential the agent needs.
META_MODEL_API_KEY=
# Shared secret signing both directions of Channels traffic.
MANO_AGENT_SECRET=
# Channels worker base URL, for reminder and nudge delivery.
MANO_CHANNELS_URL=
# Engine base URL, and Engine's SESSION_SECRET (same value), which the
# agent uses to mint short-lived person tokens for memory and actions.
ENGINE_URL=
ENGINE_SESSION_SECRET=
# IANA timezone for day-relative reminder times. Default America/Denver.
MANO_TIMEZONE=
# Vercel KV (Redis) for reminders, the turn ledger and pending approvals.
# Required everywhere except local development.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set to development locally to keep that state in process memory
# instead (never honored on a production deployment).
MANO_ENV=
