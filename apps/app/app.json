{
  "expo": {
    "name": "Mano",
    "slug": "mano",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mano",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.withmano.app"
    },
    "android": {
      "package": "com.withmano.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mano reads the mail and documents you photograph so it can track deadlines and fill out forms.",
          "cameraPermission": "Mano photographs your mail and documents so it can track deadlines and fill out forms.",
          "microphonePermission": "Mano records short videos of your mail when you choose to film instead of photographing."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
