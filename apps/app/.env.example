# Copy to .env.local and fill in. Never commit values.
# The engine Worker URL, for example https://mano-engine.<account>.workers.dev.
# When empty, the app talks to the stand-in engine with recorded synthetic
# responses and says so on the sign-in screen.
EXPO_PUBLIC_ENGINE_URL=
# Expo project ID for push notifications. Local reminders work without it.
EXPO_PUBLIC_EAS_PROJECT_ID=
