# Copy to .env.local and fill in. Never commit values.
# The web Worker URL (apps/web), which serves sign-in and chat, for example https://app.example.org.
EXPO_PUBLIC_ENGINE_URL=
# Set to "true" to run against the stand-in engine with recorded synthetic
# responses. The app refuses to start with neither this nor the engine URL.
EXPO_PUBLIC_DEMO_MODE=
