{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "env": {
          "EXPO_PUBLIC_ENGINE_URL": "https://app.withmano.com"
        }
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true,
        "env": {
          "EXPO_PUBLIC_ENGINE_URL": "https://app.withmano.com"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
