# Copy to .dev.vars for local `wrangler dev` overrides. Values here are the defaults.
# SANDBOX_PORTAL_TOKEN is a secret (wrangler secret put). Without it, staff and API access is off.
SESSION_TIMEOUT_MINUTES=15
SLOW_MS_DEFAULT=20000
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=3
RATE_LIMIT_PER_MINUTE=60
SLOW_MAX_CONCURRENT=5
