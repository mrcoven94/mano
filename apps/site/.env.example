# Names only; set values in Vercel or a local .env (never commit them).
NEXT_PUBLIC_SMS_NUMBER=
NEXT_PUBLIC_APP_URL=
# Public base URL of the mano-meter R2 bucket (custom domain or public
# URL). /stats reads usage and history summaries from here; unset
# means the page shows its not-published states.
METER_R2_PUBLIC_BASE=
