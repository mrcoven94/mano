# Names only; set values in Vercel or a local .env (never commit them).
NEXT_PUBLIC_SMS_NUMBER=
NEXT_PUBLIC_APP_URL=
# Accounts sign-in on withmano.com/sign-in and /account. Without these, the
# routes run on stand-ins locally and print which parts are not live.
MANO_WORKOS_API_KEY=
MANO_WORKOS_CLIENT_ID=
MANO_WORKOS_REDIRECT_URI=
MANO_ACCOUNTS_PEPPER=
MANO_ACCOUNTS_KEK_B64=
# Staff token for /quality. Leave empty to keep the page closed.
QUALITY_STAFF_TOKEN=
# Read keys for the nightly quality runs: aggregates in bucket mano-quality,
# per-case results in mano-quality-private. Read server-side only with signed
# requests. Never public, never NEXT_PUBLIC.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
