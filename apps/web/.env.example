# Names only. Copy to .dev.vars for wrangler dev; never commit values.
# Signs handle grants, shared with Engine and Channels. Web sessions and sign-in
# codes use keys derived from it, so the web adds no new secret.
MANO_HANDLE_GRANT_SECRET=
# Signs agent traffic both ways, shared with the agent and Channels.
MANO_AGENT_SECRET=
# The agent's base URL.
AGENT_URL=
# Turns an address into a person, the same pepper Channels uses.
MANO_HANDLE_PEPPER=
